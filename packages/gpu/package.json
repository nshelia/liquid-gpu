{
  "name": "@liquid-gpu/gpu",
  "version": "0.0.0",
  "description": "WebGPU device, HTML-in-Canvas capture, layer compositor, Liquid Glass renderer and CSS fallback for liquid-gpu.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-imports.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:serve": "vite test --port 5178 --strictPort",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "typescript": "^5.6.0",
    "@liquid-gpu/core": "*"
  },
  "module": "./dist/index.js"
}
