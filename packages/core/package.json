{
  "name": "@liquid-gpu/core",
  "version": "0.1.0",
  "description": "Framework-free iOS 27 motion core: springs, UIScrollView physics, gesture decision rules, design tokens.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-imports.mjs dist",
    "clean": "rm -rf dist"
  },
  "module": "./dist/index.js"
}
